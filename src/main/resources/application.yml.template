spring:
  application:
    name: point-quest-backend
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: ${POINTQUEST_DB_URL:jdbc:mysql://localhost:3306/point_quest?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true}
    username: ${POINTQUEST_DB_USERNAME:root}
    password: ${POINTQUEST_DB_PASSWORD:root}
  data:
    redis:
      host: ${POINTQUEST_REDIS_HOST:localhost}
      port: ${POINTQUEST_REDIS_PORT:6379}
      password: ${POINTQUEST_REDIS_PASSWORD:}
      database: ${POINTQUEST_REDIS_DATABASE:0}
      timeout: 3s

mybatis-plus:
  mapper-locations: classpath*:/mapper/**/*.xml
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      logic-delete-field: is_del
      logic-delete-value: 1
      logic-not-delete-value: 0

storage:
  provider: ${POINTQUEST_STORAGE_PROVIDER:minio}
  minio:
    endpoint: ${POINTQUEST_MINIO_ENDPOINT:http://localhost:9000}
    access-key: ${POINTQUEST_MINIO_ACCESS_KEY:minioadmin}
    secret-key: ${POINTQUEST_MINIO_SECRET_KEY:minioadmin}
    bucket: ${POINTQUEST_MINIO_BUCKET:pointquest}
    region: ${POINTQUEST_MINIO_REGION:}
    public-url: ${POINTQUEST_MINIO_PUBLIC_URL:}
    use-ssl: ${POINTQUEST_MINIO_USE_SSL:false}

security:
  jwt:
    secret: ${POINTQUEST_JWT_SECRET:pointquest-dev-secret-change-me-please-123456}
    expires-minutes: ${POINTQUEST_JWT_EXPIRES_MINUTES:120}